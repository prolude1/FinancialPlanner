# Prefer: python3 scripts/configure.py (stdlib only; no virtual environment).
POSTGRES_PASSWORD=replace-with-a-random-hex-secret
SESSION_SECRET=replace-with-at-least-32-random-characters
BOT_API_SECRET=replace-with-a-random-secret
# PBKDF2-SHA256, 600000 iterations, salt_hex:hash_hex. configure.py generates this.
WEB_PASSWORD_HASH=replace-with-generated-hash
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
# Public username, used only to construct Telegram deep links; do not include @.
TELEGRAM_BOT_USERNAME=
# Keycloak bearer validation for the Stage 1 linking endpoints. Blank disables them.
KEYCLOAK_ISSUER=
KEYCLOAK_AUDIENCE=
KEYCLOAK_JWKS_URL=
WEB_PORT=8080
APP_TIMEZONE=Asia/Singapore
MARKET_POLL_SECONDS=900
CATALOG_REFRESH_SECONDS=86400
HISTORY_REFRESH_SECONDS=21600
STOCK_PRICE_PROVIDER=yahoo
